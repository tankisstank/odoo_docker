<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Line Tree View -->
    <record id="view_qlv_stock_balance_line_tree" model="ir.ui.view">
        <field name="name">qlv.stock.balance.line.tree</field>
        <field name="model">qlv.stock.balance.line</field>
        <field name="arch" type="xml">
            <tree string="Stock Details" decoration-info="ownership_type == 'customer_debt'" decoration-danger="ownership_type == 'customer_pawn'">
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="uom_id"/>
                <field name="ownership_type" />
                <field name="opening_qty" optional="show"/>
                <field name="in_qty" optional="show"/>
                <field name="out_qty" optional="show"/>
                <field name="closing_qty" optional="show"/>
                <field name="current_price" optional="hide"/>
                <field name="closing_value" sum="Total Value" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Line Search View -->
    <record id="view_qlv_stock_balance_line_search" model="ir.ui.view">
        <field name="name">qlv.stock.balance.line.search</field>
        <field name="model">qlv.stock.balance.line</field>
        <field name="arch" type="xml">
            <search string="Search Lines">
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="ownership_type"/>
                <separator/>
                <filter string="Trên quầy" name="filter_shop" domain="[('ownership_type', '=', 'shop')]"/>
                <filter string="K' Nợ" name="filter_debt" domain="[('ownership_type', '=', 'customer_debt')]"/>
                <filter string="K' Gửi sổ" name="filter_pawn" domain="[('ownership_type', '=', 'customer_pawn')]"/>
                <separator/>
                <filter string="Còn tồn" name="filter_stock" domain="[('closing_qty', '&gt;', 0)]"/>
                <group expand="1" string="Nhóm theo">
                    <filter string="Nhóm hàng" name="group_category" context="{'group_by':'category_id'}"/>
                    <filter string="Loại" name="group_type" context="{'group_by':'ownership_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Grouped Line View -->
    <record id="action_qlv_stock_balance_lines_grouped" model="ir.actions.act_window">
        <field name="name">Chi tiết theo Nhóm Sản phẩm</field>
        <field name="res_model">qlv.stock.balance.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('report_id', '=', active_id)]</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="view_id" ref="view_qlv_stock_balance_line_tree"/>
        <field name="search_view_id" ref="view_qlv_stock_balance_line_search"/>
    </record>

    <!-- Report Form View -->
    <record id="view_qlv_stock_balance_form" model="ir.ui.view">
        <field name="name">qlv.stock.balance.form</field>
        <field name="model">qlv.stock.balance</field>
        <field name="arch" type="xml">
            <form string="Stock Balance Report">
                <header>
                    <button name="action_compute_report" string="Cập nhật Số liệu" type="object" class="oe_highlight" attrs="{'invisible': [('state', '=', 'confirmed')]}"/>
                    <button name="action_confirm_report" string="Chốt sổ" type="object" class="btn-success" attrs="{'invisible': [('state', '=', 'confirmed')]}" confirm="Bạn có chắc chắn muốn chốt sổ báo cáo này? Sau khi chốt sẽ không thể sửa đổi."/>
                    <button name="action_draft_report" string="Mở lại" type="object" class="btn-warning" attrs="{'invisible': [('state', '=', 'draft')]}" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_qlv_stock_balance_lines_grouped)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-list"
                                context="{'active_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Xem theo nhóm</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Đã chốt sổ" bg_color="bg-success" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="date_to" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="filter_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="confirmed_by" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                            <field name="confirmed_date" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tổng hợp Lãi/Lỗ" name="page_pnl">
                            <group>
                                <group string="TÀI SẢN SHOP (Tính Lãi/Lỗ)" col="4">
                                    <field name="shop_opening_stock_value" string="ĐK Hàng hóa"/>
                                    <field name="shop_closing_stock_value" string="CK Hàng hóa"/>
                                    <field name="shop_opening_cash" string="ĐK Tiền mặt"/>
                                    <field name="shop_closing_cash" string="CK Tiền mặt"/>
                                    <field name="shop_total_opening" string="TỔNG ĐẦU KỲ" decoration-bf="1"/>
                                    <field name="shop_total_closing" string="TỔNG CUỐI KỲ" decoration-bf="1"/>
                                </group>
                                <group string="KẾT QUẢ">
                                    <field name="profit_loss" string="LÃI / LỖ" widget="monetary" options="{'currency_field': 'currency_id'}" 
                                           decoration-success="profit_loss > 0" decoration-danger="profit_loss &lt; 0"
                                           class="oe_inline" style="font-size: 1.5em; font-weight: bold;"/>
                                </group>
                            </group>
                            <separator string="THÔNG TIN TÁCH BIỆT"/>
                            <group>
                                <group string="Hàng gửi sổ (Pawn)">
                                    <field name="pawn_opening_value" string="Đầu kỳ"/>
                                    <field name="pawn_closing_value" string="Cuối kỳ"/>
                                </group>
                                <group string="Công nợ Khách">
                                    <field name="debt_opening_value" string="Đầu kỳ"/>
                                    <field name="debt_closing_value" string="Cuối kỳ"/>
                                </group>
                            </group>
                        </page>
                        <page string="Chi tiết Tồn kho &amp; Công nợ" name="page_details">
                            <field name="filtered_line_ids">
                                <tree string="Lines" 
                                      decoration-info="ownership_type == 'shop'" 
                                      decoration-success="ownership_type == 'customer_debt'" 
                                      decoration-warning="ownership_type == 'customer_pawn'"
                                      decoration-danger="closing_qty &lt; 0"
                                      decoration-bf="1">
                                    <field name="product_id" string="Sản phẩm"/>
                                    <field name="category_id" string="Nhóm" optional="hide"/>
                                    <field name="ownership_type" string="Loại"/>
                                    <field name="uom_id" string="ĐVT" optional="hide"/>
                                    <field name="opening_qty" string="Đầu kỳ" sum="Tổng ĐK"/>
                                    <field name="in_qty" string="Nhập" sum="Tổng Nhập"/>
                                    <field name="out_qty" string="Xuất" sum="Tổng Xuất"/>
                                    <field name="closing_qty" string="Cuối kỳ" sum="Tổng CK" decoration-bf="1"/>
                                    <field name="current_price" string="Giá mua" optional="show"/>
                                    <field name="closing_value" string="Thành tiền" sum="Tổng giá trị" decoration-bf="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Tổng hợp theo nhóm" name="page_summary">
                            <p class="text-muted">Click vào nút bên dưới để xem chi tiết theo nhóm sản phẩm (có thể mở rộng/thu gọn)</p>
                            <button name="%(action_qlv_stock_balance_lines_grouped)d" 
                                    type="action" 
                                    string="📊 Xem theo Nhóm Sản phẩm" 
                                    class="btn-primary"
                                    context="{'active_id': id, 'search_default_group_category': 1}"/>
                            <separator/>
                            <field name="summary_line_ids">
                                <tree string="Tổng hợp nhanh" decoration-bf="1">
                                    <field name="sequence" string="STT"/>
                                    <field name="category_id" string="Nhóm SP"/>
                                    <field name="opening_qty" string="Tồn ĐK" sum="Tổng"/>
                                    <field name="in_qty" string="Nhập" sum="Tổng"/>
                                    <field name="out_qty" string="Xuất" sum="Tổng"/>
                                    <field name="closing_qty" string="Tồn CK" sum="Tổng" decoration-bf="1"/>
                                    <field name="closing_value" string="Thành tiền" sum="Tổng" decoration-bf="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Report Tree View -->
    <record id="view_qlv_stock_balance_tree" model="ir.ui.view">
        <field name="name">qlv.stock.balance.tree</field>
        <field name="model">qlv.stock.balance</field>
        <field name="arch" type="xml">
            <tree string="Báo cáo Lãi/Lỗ" decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="profit_loss" string="Lãi/Lỗ" decoration-success="profit_loss > 0" decoration-danger="profit_loss &lt; 0"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
                <field name="confirmed_by"/>
                <field name="confirmed_date"/>
            </tree>
        </field>
    </record>

    <!-- Sequence -->
    <record id="seq_qlv_stock_balance" model="ir.sequence">
        <field name="name">QLV Stock Balance Sequence</field>
        <field name="code">qlv.stock.balance</field>
        <field name="prefix">BC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Action -->
    <record id="action_qlv_stock_balance_report" model="ir.actions.act_window">
        <field name="name">Báo cáo Lãi/Lỗ Hàng ngày</field>
        <field name="res_model">qlv.stock.balance</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo báo cáo Lãi/Lỗ đầu tiên
            </p>
            <p>
                Báo cáo Lãi/Lỗ hàng ngày giúp bạn theo dõi hiệu quả kinh doanh của cửa hàng.
            </p>
        </field>
    </record>
</odoo>
